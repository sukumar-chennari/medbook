# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored. NEVER commit it. These values are safe placeholders for LOCAL use only.
# On a real server, generate strong values, e.g.:  openssl rand -hex 24
# Keep values to letters, digits and dashes (they are placed inside connection URLs).

# --- MongoDB ---
# Admin user created the first time the database volume is initialised.
MONGO_ROOT_USERNAME=medbook_admin
MONGO_ROOT_PASSWORD=change-me-mongo-password
# Name of the application database.
MONGO_DB_NAME=medbook

# --- Redis ---
# Password required to talk to Redis.
REDIS_PASSWORD=change-me-redis-password

# --- Dev tools ---
# Login for mongo-express (database browser at http://localhost:8081, dev only).
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-me-mongo-express-password

# --- App ---
# Log detail: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Ports on your own machine.
API_PORT=4000
WEB_PORT=5173

# --- Auth (Phase 1) ---
# Secret that signs access tokens. At least 32 characters. (Refresh tokens are random values stored hashed in the database, so they need no secret.)
# These are LOCAL placeholders. On a real server generate new ones:  openssl rand -hex 32
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-0123456789

# --- Added in later phases (documented here so nothing is a surprise) ---
# Phase 4: SMTP settings for reminder emails
# Phase 6: S3-compatible storage endpoint, access key, secret key, bucket
# Phase 7: LLM API key
